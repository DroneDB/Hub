{
  "name": "hub",
  "version": "2.7.0",
  "description": "JS Client Application for Registry",
  "main": "webpack.config.js",
  "scripts": {
    "dev": "npx webpack --watch",
    "build": "npx webpack",
    "build:prod": "cross-env NODE_ENV=production npx webpack",
    "pub-dev": "node scripts/pub-dev.js",
    "test": "vitest run",
    "build:stats": "cross-env NODE_ENV=production npx webpack --json=stats.json",
    "check:bundle": "node scripts/check_bundle_budget.mjs stats.json build",
    "check:listeners": "node scripts/audit_listeners.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "e2e": "node --test --test-concurrency=1 e2e/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DroneDB/Hub.git"
  },
  "author": "",
  "license": "AGPLv3",
  "bugs": {
    "url": "https://github.com/DroneDB/Hub/issues"
  },
  "homepage": "https://github.com/DroneDB/Hub#readme",
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.0",
    "@giro3d/giro3d": "^2.0.3",
    "@primevue/themes": "^4.5.4",
    "@sparkjsdev/spark": "^2.1.0",
    "@tanstack/vue-virtual": "^3.10.0",
    "@turf/bbox": "^6.0.1",
    "@turf/meta": "^6.0.2",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "clipboard-copy": "^4.0.1",
    "dompurify": "^3.3.1",
    "fslightbox-vue": "^3.0.3",
    "markdown-it": "^14.1.0",
    "mitt": "^3.0.1",
    "ol": "^10.9.0",
    "pinia": "^3.0.4",
    "primevue": "^4.3.0",
    "proj4": "^2.20.9",
    "three": "^0.180.0",
    "vue": "^3.5.11",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.5.1",
    "babel-loader": "^9.1.3",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.10.0",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "happy-dom": "^17.0.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "playwright": "^1.58.2",
    "sass": "^1.72.0",
    "sass-loader": "^14.1.0",
    "typescript": "~5.9",
    "vitest": "^3.0.0",
    "vue-loader": "^17.4.0",
    "vue-style-loader": "^4.1.3",
